# Application
NODE_ENV=development
PORT=3000

# PostgreSQL Connection (required)
DATABASE_URL=postgres://app:secret@localhost:5432/resources

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Docker Compose overrides (optional)
POSTGRES_USER=app
POSTGRES_PASSWORD=secret
POSTGRES_DB=resources
DB_PORT=5432
APP_PORT=3000
